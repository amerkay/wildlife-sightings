# Environment Configuration
ENVIRONMENT=dev

# Domain Configuration (production only)
DOMAIN=identify-api.wildamer.com
ACME_EMAIL=itsme@wildamer.com

# CORS Settings
# Dev: Allow all origins for testing
# Prod: Should be set to your domain or removed for Traefik proxy
CORS_ALLOW_ORIGINS=https://amerkay.github.io

# Traefik Configuration
TRAEFIK_DASHBOARD=true
TRAEFIK_LOG_LEVEL=INFO

# API Configuration
TOP_K=5
MIN_CONF=0.0
TORCH_NUM_THREADS=2

# Bird Image API - Detector Settings
DETECTOR_WEIGHTS=/home/appuser/models/yolov8n.pt
DETECTOR_CONF=0.25
DETECTOR_IOU=0.5
DETECTOR_MARGIN=0.05
CLASSIFY_ALL_DETS=false


